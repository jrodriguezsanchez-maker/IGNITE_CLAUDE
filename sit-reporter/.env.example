# === JIRA OAuth 2.0 (Atlassian Developer Console) ===
JIRA_CLIENT_ID=your_atlassian_oauth_client_id
JIRA_CLIENT_SECRET=your_atlassian_oauth_client_secret
JIRA_REDIRECT_URI=http://localhost:8080/callback
JIRA_BASE_URL=https://your-company.atlassian.net

# === Xray Cloud API Keys (Xray > API Keys) ===
XRAY_CLIENT_ID=your_xray_client_id
XRAY_CLIENT_SECRET=your_xray_client_secret

# === Microsoft Graph / Azure AD ===
AZURE_TENANT_ID=your_accenture_tenant_id
AZURE_CLIENT_ID=your_azure_app_client_id

# === Email Config ===
